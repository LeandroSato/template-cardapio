---
import type { Categoria } from '../lib/cardapio';
import { formatarPreco, rotuloDias } from '../lib/cardapio';
import ControleQuantidade from './ControleQuantidade.astro';

interface Props {
  categoria: Categoria;
}
const { categoria: c } = Astro.props;
---

<section id={c.id} aria-labelledby={`titulo-${c.id}`} class="conteiner pt-10 md:pt-14" data-secao-categoria>
  <h2 id={`titulo-${c.id}`} class="font-letreiro text-[1.9rem] leading-tight text-parede md:text-4xl">{c.nome}</h2>
  {c.descricao && <p class="mt-1 text-apagado md:text-lg">{c.descricao}</p>}

  <!-- Celular: lista com divisórias. A partir do md: grade de cartões. -->
  <ul class="mt-3 divide-y divide-rejunte md:mt-5 md:grid md:grid-cols-2 md:gap-4 md:divide-y-0">
    {c.itens.map((item) => (
      <li
        class="flex gap-3 py-4 md:gap-4 md:rounded-xl md:border md:border-rejunte md:bg-folha md:p-4 md:transition-shadow md:duration-200 md:hover:shadow-md"
        data-item={item.id}
        data-dias={item.dias?.join(' ')}
      >
        {item.imagem ? (
          <img
            src={item.imagem}
            alt={item.nome}
            width="96"
            height="96"
            loading="lazy"
            decoding="async"
            class="size-16 shrink-0 rounded-lg object-cover md:size-20 lg:size-24"
          />
        ) : (
          <div class="prato-vazio size-16 shrink-0 rounded-lg md:size-20 lg:size-24" aria-hidden="true"></div>
        )}

        <div class="flex min-w-0 flex-1 flex-col">
          <div class="flex items-end md:flex-col md:items-start md:gap-0.5 lg:flex-row lg:items-end lg:gap-0">
            <h3 class="text-lg leading-snug font-bold">{item.nome}</h3>
            <span class="pontilhado md:hidden lg:block" aria-hidden="true"></span>
            <p class="font-letreiro shrink-0 text-xl whitespace-nowrap text-parede md:text-2xl">{formatarPreco(item.preco)}</p>
          </div>
          {item.descricao && <p class="mt-1 text-[0.95rem] leading-snug text-apagado">{item.descricao}</p>}

          <div class="mt-auto flex flex-wrap items-center justify-between gap-x-3 gap-y-2 pt-3">
            {item.dias?.length ? (
              <p class="text-sm font-bold text-parede" data-rotulo-dias>
                <span data-rotulo-hoje class="mr-1 hidden rounded bg-gema px-1.5 py-0.5 text-tinta">Hoje</span>
                {rotuloDias(item.dias)}
              </p>
            ) : (
              <span></span>
            )}
            <ControleQuantidade id={item.id} nome={item.nome} />
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>

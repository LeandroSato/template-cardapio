---
import { cardapio, enderecoCompleto, linkComoChegar, linkMapaEmbed } from '../lib/cardapio';
import Icone from './Icone.astro';
import Horarios from './Horarios.astro';
const { endereco: e, contato, restaurante: r } = cardapio;
const telefoneLink = `tel:+55${contato.telefone.replace(/\D/g, '')}`;
---

<section id="onde-estamos" aria-labelledby="titulo-onde" class="conteiner mt-12" data-secao-categoria>
  <h2 id="titulo-onde" class="font-letreiro text-2xl text-parede md:text-4xl">Onde estamos</h2>

  <div class="mt-3 grid gap-8 lg:grid-cols-2 lg:gap-12">
    <div>
      <address class="text-lg leading-snug not-italic">
        {e.rua}<br />
        {e.bairro}, {e.cidade} – {e.uf}<br />
        <span class="text-base text-apagado">CEP {e.cep}</span>
      </address>
      {e.referencia && <p class="mt-2 text-apagado">{e.referencia}</p>}

      <div class="mt-4 flex flex-wrap gap-3">
        <a
          href={linkComoChegar()}
          target="_blank"
          rel="noopener"
          class="flex min-h-12 items-center gap-2 rounded-lg bg-parede px-5 font-bold text-papel transition-colors duration-150 hover:bg-parede/90"
        >
          <Icone nome="rota" class="size-5" />
          Como chegar<span class="sr-only"> (abre o Google Maps)</span>
        </a>
        <a
          href={telefoneLink}
          class="flex min-h-12 items-center gap-2 rounded-lg border-2 border-parede px-5 font-bold text-parede transition-colors duration-150 hover:bg-parede hover:text-papel"
        >
          <Icone nome="telefone" class="size-5" />
          Ligar {contato.telefone}
        </a>
      </div>

      <h3 class="mt-8 flex items-center gap-2 text-lg font-bold">
        <Icone nome="relogio" class="size-5 text-parede" />
        Horário de funcionamento
      </h3>
      <Horarios class="mt-2" />
    </div>

    <!-- O mapa só carrega quando a pessoa pede: a página abre mais rápido no 4G. -->
    <div
      class="relative aspect-[4/3] overflow-hidden rounded-xl border-2 border-rejunte bg-rejunte/40 lg:aspect-auto lg:min-h-96"
      data-mapa
    >
      <button
        type="button"
        data-carregar-mapa={linkMapaEmbed()}
        class="absolute inset-0 flex flex-col items-center justify-center gap-2 p-4 text-center transition-colors duration-150 hover:bg-rejunte/40"
      >
        <Icone nome="local" class="size-8 text-parede" />
        <span class="font-letreiro text-xl text-parede">Ver no mapa</span>
        <span class="text-sm text-apagado">{enderecoCompleto()}</span>
      </button>
      <noscript>
        <iframe
          src={linkMapaEmbed()}
          title={`Mapa: ${r.nome}`}
          loading="lazy"
          class="absolute inset-0 size-full border-0"
        ></iframe>
      </noscript>
    </div>
  </div>
</section>

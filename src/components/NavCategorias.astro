---
import { cardapio } from '../lib/cardapio';
---

<nav
  aria-label="Categorias do cardápio"
  class="sticky top-0 z-30 border-b border-rejunte bg-papel/95 backdrop-blur supports-[backdrop-filter]:bg-papel/85"
>
  <!-- Celular: rolagem horizontal, com um esmaecido na borda direita mostrando que a lista continua. No lg tudo cabe. -->
  <div
    class="conteiner relative after:pointer-events-none after:absolute after:inset-y-0 after:right-0 after:w-12 after:bg-linear-to-l after:from-papel after:to-transparent lg:after:hidden"
  >
    <ul
      class="flex gap-2 overflow-x-auto py-3 pr-12 [scrollbar-width:none] lg:flex-wrap lg:justify-center lg:overflow-visible lg:pr-0 [&::-webkit-scrollbar]:hidden"
      data-nav-categorias
    >
      {cardapio.categorias.map((c) => (
        <li class="shrink-0">
          <a
            href={`#${c.id}`}
            data-nav-link={c.id}
            class="flex min-h-11 items-center rounded-full border-2 border-parede px-4 font-bold whitespace-nowrap text-parede transition-colors duration-150 hover:bg-parede/10 aria-[current=true]:bg-parede aria-[current=true]:text-papel"
          >
            {c.nome}
          </a>
        </li>
      ))}
      <li class="shrink-0">
        <a
          href="#onde-estamos"
          data-nav-link="onde-estamos"
          class="flex min-h-11 items-center rounded-full border-2 border-transparent px-4 font-bold whitespace-nowrap text-parede underline decoration-2 underline-offset-4 transition-colors duration-150 hover:bg-parede/10 aria-[current=true]:bg-parede aria-[current=true]:text-papel aria-[current=true]:no-underline"
        >
          Onde estamos
        </a>
      </li>
    </ul>
  </div>
</nav>

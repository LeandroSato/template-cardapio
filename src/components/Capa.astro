---
import { cardapio, formatarPreco, linkComoChegar } from '../lib/cardapio';
import Icone from './Icone.astro';
import Horarios from './Horarios.astro';

const { restaurante: r, endereco: e, categorias } = cardapio;
// O primeiro item com "dias" serve de conteúdo sem JavaScript;
// o script hoje.ts troca pelo prato do dia de verdade.
const pratosDoDia = categorias.flatMap((c) => c.itens.filter((i) => i.dias?.length));
const padrao = pratosDoDia[0];
---

<header class="bg-parede text-papel">
  <div class="conteiner flex items-center gap-3 pt-5 pb-2 lg:pt-7">
    <img src={r.logo} alt="" width="56" height="56" class="size-11 shrink-0 rounded-full bg-papel lg:size-14" />
    <div class="min-w-0">
      <h1 class="font-letreiro text-xl leading-tight lg:text-3xl">{r.nome}</h1>
      <p class="text-sm opacity-85 lg:text-base">{r.tipoComida} · {e.bairro}</p>
    </div>
    <!-- O script hoje.ts escreve o texto em [data-status-aberto] e tira o "hidden" dele; a pílula aparece junto. -->
    <p
      class="ml-auto hidden shrink-0 items-center gap-2 rounded-full border border-papel/40 bg-papel/10 px-3 py-1.5 text-sm font-bold has-[[data-status-aberto]:not(.hidden)]:flex"
    >
      <Icone nome="relogio" class="size-4" />
      <span data-status-aberto class="hidden"></span>
    </p>
  </div>

  <div class="conteiner grid gap-8 pt-6 pb-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:items-center lg:gap-14 lg:pt-10 lg:pb-12">
    {padrao && (
      <section aria-labelledby="prato-hoje-nome" data-prato-hoje>
        <p class="flex items-center gap-2 text-sm font-bold tracking-wide text-gema uppercase lg:text-base">
          <Icone nome="talher" class="size-5" />
          <span data-prato-hoje-dia>Prato do dia</span>
        </p>
        <h2
          id="prato-hoje-nome"
          class="font-letreiro mt-3 text-[2.6rem] leading-[1.02] text-balance lg:text-5xl xl:text-6xl"
          data-prato-hoje-nome
        >
          {padrao.nome}
        </h2>
        <p class="mt-4 max-w-prose text-base leading-relaxed opacity-90 lg:text-lg" data-prato-hoje-descricao>
          {padrao.descricao}
        </p>
        <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 lg:justify-start" data-prato-hoje-acoes>
          <p class="font-letreiro text-[2rem] whitespace-nowrap text-gema lg:text-5xl" data-prato-hoje-preco>
            {formatarPreco(padrao.preco)}
          </p>
          <button
            type="button"
            class="min-h-12 rounded-lg bg-gema px-6 text-lg font-bold whitespace-nowrap text-tinta shadow-[0_3px_0_rgb(0_0_0/0.25)] transition-[background-color,box-shadow,transform] duration-150 hover:bg-gema/90 active:translate-y-[2px] active:shadow-none"
            data-adicionar={padrao.id}
            data-prato-hoje-botao
          >
            Adicionar
          </button>
        </div>
        <p class="mt-4 hidden text-base" data-prato-hoje-aviso></p>
      </section>
    )}

    <!-- Cartão de informações: só no desktop; no celular a barra fixa e a seção "Onde estamos" já cobrem. -->
    <aside aria-labelledby="capa-info-titulo" class="hidden rounded-2xl bg-folha p-6 text-tinta shadow-[0_6px_0_rgb(0_0_0/0.25)] lg:block">
      <h2 id="capa-info-titulo" class="font-letreiro text-2xl text-parede">Horário e endereço</h2>

      <p class="mt-4 flex gap-3 leading-snug">
        <Icone nome="local" class="mt-0.5 size-5 text-parede" />
        <span>{e.rua}<br />{e.bairro}, {e.cidade} – {e.uf}</span>
      </p>

      <h3 class="mt-5 mb-2 flex items-center gap-3 font-bold">
        <Icone nome="relogio" class="size-5 text-parede" />
        Horário de funcionamento
      </h3>
      <Horarios />

      <div class="mt-6 grid gap-3">
        <button
          type="button"
          data-abrir-comanda
          class="flex min-h-12 items-center justify-center gap-2 rounded-lg bg-parede px-5 font-bold text-papel shadow-[0_3px_0_rgb(0_0_0/0.25)] transition-[background-color,box-shadow,transform] duration-150 hover:bg-parede/90 active:translate-y-[2px] active:shadow-none"
        >
          <Icone nome="whatsapp" class="size-5" />
          Pedir no WhatsApp
        </button>
        <a
          href={linkComoChegar()}
          target="_blank"
          rel="noopener"
          class="flex min-h-12 items-center justify-center gap-2 rounded-lg border-2 border-parede px-5 font-bold text-parede transition-colors duration-150 hover:bg-parede hover:text-papel"
        >
          <Icone nome="rota" class="size-5" />
          Como chegar<span class="sr-only"> (abre o Google Maps)</span>
        </a>
      </div>
    </aside>
  </div>

  <div class="azulejo h-7 border-t-4 border-parede" aria-hidden="true"></div>
</header>

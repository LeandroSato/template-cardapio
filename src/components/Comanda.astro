---
import { cardapio } from '../lib/cardapio';
import Icone from './Icone.astro';
const { restaurante: r, pedido } = cardapio;
---

<!-- Celular: barra fixa de largura total. No lg: pílula flutuante centralizada, para não virar uma faixa esticada. -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-rejunte bg-papel/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur lg:inset-x-auto lg:bottom-6 lg:left-1/2 lg:w-auto lg:min-w-72 lg:-translate-x-1/2 lg:border-0 lg:bg-transparent lg:p-0 lg:backdrop-blur-none"
>
  <div class="mx-auto max-w-xl lg:max-w-none">
    <button
      type="button"
      data-abrir-comanda
      class="flex min-h-14 w-full items-center justify-between gap-3 lg:justify-center lg:gap-5 rounded-xl bg-parede px-5 font-bold text-papel shadow-[0_4px_0_rgb(0_0_0/0.25)] transition-[background-color,box-shadow,transform] duration-150 hover:bg-parede/90 active:translate-y-[2px] active:shadow-none lg:rounded-full lg:shadow-[0_6px_18px_rgb(0_0_0/0.3)] lg:active:shadow-[0_2px_8px_rgb(0_0_0/0.3)]"
    >
      <span class="flex items-center gap-3">
        <Icone nome="sacola" class="size-5" />
        <span data-barra-texto>Pedir no WhatsApp</span>
      </span>
      <span class="rounded-md bg-gema px-2.5 py-1 text-tinta tabular-nums lg:rounded-full" data-barra-total hidden></span>
    </button>
  </div>
</div>

<dialog
  data-comanda
  aria-labelledby="comanda-titulo"
  class="m-0 mt-auto w-full max-w-none bg-transparent p-0 backdrop:bg-tinta/55 sm:mx-auto sm:mb-6 sm:max-w-lg lg:my-auto lg:max-w-xl"
>
  <div class="serrilha mx-auto max-h-[88dvh] overflow-y-auto overscroll-contain bg-folha px-5 pt-7 pb-[max(1.25rem,env(safe-area-inset-bottom))] font-comanda text-tinta shadow-2xl lg:max-h-[85dvh] lg:px-8 lg:pb-8">
    <div class="flex items-start justify-between gap-3 border-b-2 border-dashed border-rejunte pb-3">
      <div>
        <h2 id="comanda-titulo" class="text-2xl font-bold tracking-[0.2em] uppercase">Comanda</h2>
        <p class="text-sm">{r.nome} · <span data-comanda-data></span></p>
      </div>
      <button
        type="button"
        data-fechar-comanda
        class="-mt-1 -mr-2 flex size-11 items-center justify-center rounded-lg transition-colors duration-150 hover:bg-rejunte/50"
        aria-label="Fechar comanda"
      >
        <Icone nome="fechar" class="size-6" />
      </button>
    </div>

    <p class="py-6 text-center" data-comanda-vazia>
      Nenhum item ainda. Toque em <strong>Adicionar</strong> nos pratos do cardápio.
    </p>

    <ul class="divide-y divide-dashed divide-rejunte" data-comanda-lista></ul>

    <div class="mt-2 flex items-baseline justify-between border-t-2 border-tinta pt-3 text-xl font-bold" data-comanda-totalbloco hidden>
      <span>TOTAL</span>
      <span class="tabular-nums" data-comanda-total></span>
    </div>

    <form class="mt-5 space-y-4 font-corpo" data-comanda-form novalidate>
      {pedido.pedirNome && (
        <div>
          <label for="comanda-nome" class="block font-bold">Seu nome</label>
          <input
            id="comanda-nome"
            name="nome"
            autocomplete="given-name"
            required
            class="mt-1 min-h-12 w-full rounded-lg border-2 border-apagado bg-papel px-3 text-base focus:border-parede"
            aria-describedby="comanda-nome-erro"
          />
          <p id="comanda-nome-erro" class="mt-1 hidden text-sm font-bold text-[#A3261C]" data-erro-nome>
            Escreva seu nome para o restaurante saber de quem é o pedido.
          </p>
        </div>
      )}
      <div>
        <label for="comanda-obs" class="block font-bold">Observação <span class="font-normal text-apagado">(opcional)</span></label>
        <textarea
          id="comanda-obs"
          name="observacao"
          rows="2"
          placeholder="Ex.: sem cebola, vou retirar às 12h30"
          class="mt-1 w-full rounded-lg border-2 border-apagado bg-papel px-3 py-2 text-base placeholder:text-apagado focus:border-parede"
        ></textarea>
      </div>

      <button
        type="submit"
        class="flex min-h-14 w-full items-center justify-center gap-2 rounded-xl bg-gema px-5 text-lg font-bold text-tinta shadow-[0_4px_0_rgb(0_0_0/0.2)] transition-[background-color,box-shadow,transform] duration-150 hover:bg-gema/90 active:translate-y-[2px] active:shadow-none disabled:opacity-50"
        data-comanda-enviar
      >
        <Icone nome="whatsapp" class="size-5" />
        Pedir no WhatsApp
      </button>
      <p class="text-center text-sm text-apagado">Abre o WhatsApp com o pedido escrito. Você confere antes de enviar.</p>
      <button type="button" class="mx-auto block min-h-11 px-4 text-sm font-bold text-apagado underline transition-colors duration-150 hover:text-tinta" data-limpar-comanda hidden>
        Limpar comanda
      </button>
    </form>
  </div>
</dialog>

<template data-modelo-linha>
  <li class="flex items-center gap-3 py-3">
    <div class="min-w-0 flex-1">
      <p class="leading-snug font-bold" data-linha-nome></p>
      <p class="text-sm tabular-nums" data-linha-subtotal></p>
    </div>
    <div class="flex items-center rounded-lg border-2 border-tinta">
      <button type="button" class="flex size-11 items-center justify-center transition-colors duration-150 hover:bg-rejunte/50" data-linha-menos>
        <Icone nome="menos" class="size-5" />
      </button>
      <span class="min-w-6 text-center font-bold tabular-nums" data-linha-qtd></span>
      <button type="button" class="flex size-11 items-center justify-center transition-colors duration-150 hover:bg-rejunte/50" data-linha-mais>
        <Icone nome="mais" class="size-5" />
      </button>
    </div>
  </li>
</template>

---
import { cardapio } from '../lib/cardapio';
const { restaurante: r, pedido } = cardapio;
---

<!-- Barra fixa no rodapé: o botão de pedido fica sempre à vista. -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-rejunte bg-papel/95 px-4 pt-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] backdrop-blur"
>
  <div class="mx-auto max-w-xl">
    <button
      type="button"
      data-abrir-comanda
      class="flex min-h-14 w-full items-center justify-between gap-3 rounded-xl bg-parede px-5 font-bold text-papel shadow-[0_4px_0_rgb(0_0_0/0.25)] active:translate-y-[2px] active:shadow-none"
    >
      <span data-barra-texto>Pedir no WhatsApp</span>
      <span class="rounded-md bg-gema px-2.5 py-1 text-tinta tabular-nums" data-barra-total hidden></span>
    </button>
  </div>
</div>

<dialog
  data-comanda
  aria-labelledby="comanda-titulo"
  class="m-0 mt-auto w-full max-w-none bg-transparent p-0 backdrop:bg-tinta/55 sm:mx-auto sm:mb-6 sm:max-w-lg"
>
  <div class="serrilha mx-auto max-h-[88dvh] overflow-y-auto bg-folha px-5 pt-7 pb-[max(1.25rem,env(safe-area-inset-bottom))] font-comanda text-tinta shadow-2xl">
    <div class="flex items-start justify-between gap-3 border-b-2 border-dashed border-rejunte pb-3">
      <div>
        <h2 id="comanda-titulo" class="text-2xl font-bold tracking-[0.2em] uppercase">Comanda</h2>
        <p class="text-sm">{r.nome} · <span data-comanda-data></span></p>
      </div>
      <button
        type="button"
        data-fechar-comanda
        class="-mt-1 -mr-2 size-11 rounded-lg text-3xl leading-none hover:bg-rejunte/50"
        aria-label="Fechar comanda"
      >×</button>
    </div>

    <p class="py-6 text-center" data-comanda-vazia>
      Nenhum item ainda. Toque em <strong>Adicionar</strong> nos pratos do cardápio.
    </p>

    <ul class="divide-y divide-dashed divide-rejunte" data-comanda-lista></ul>

    <div class="mt-2 flex items-baseline justify-between border-t-2 border-tinta pt-3 text-xl font-bold" data-comanda-totalbloco hidden>
      <span>TOTAL</span>
      <span class="tabular-nums" data-comanda-total></span>
    </div>

    <form class="mt-5 space-y-4 font-corpo" data-comanda-form novalidate>
      {pedido.pedirNome && (
        <div>
          <label for="comanda-nome" class="block font-bold">Seu nome</label>
          <input
            id="comanda-nome"
            name="nome"
            autocomplete="given-name"
            required
            class="mt-1 min-h-12 w-full rounded-lg border-2 border-rejunte bg-papel px-3 text-base focus:border-parede"
            aria-describedby="comanda-nome-erro"
          />
          <p id="comanda-nome-erro" class="mt-1 hidden text-sm font-bold text-[#A3261C]" data-erro-nome>
            Escreva seu nome para o restaurante saber de quem é o pedido.
          </p>
        </div>
      )}
      <div>
        <label for="comanda-obs" class="block font-bold">Observação <span class="font-normal text-apagado">(opcional)</span></label>
        <textarea
          id="comanda-obs"
          name="observacao"
          rows="2"
          placeholder="Ex.: sem cebola, vou retirar às 12h30"
          class="mt-1 w-full rounded-lg border-2 border-rejunte bg-papel px-3 py-2 text-base focus:border-parede"
        ></textarea>
      </div>

      <button
        type="submit"
        class="flex min-h-14 w-full items-center justify-center rounded-xl bg-gema px-5 text-lg font-bold text-tinta shadow-[0_4px_0_rgb(0_0_0/0.2)] active:translate-y-[2px] active:shadow-none disabled:opacity-50"
        data-comanda-enviar
      >
        Pedir no WhatsApp
      </button>
      <p class="text-center text-sm text-apagado">Abre o WhatsApp com o pedido escrito. Você confere antes de enviar.</p>
      <button type="button" class="mx-auto block min-h-11 px-4 text-sm font-bold text-apagado underline" data-limpar-comanda hidden>
        Limpar comanda
      </button>
    </form>
  </div>
</dialog>

<template data-modelo-linha>
  <li class="flex items-center gap-3 py-3">
    <div class="min-w-0 flex-1">
      <p class="leading-snug font-bold" data-linha-nome></p>
      <p class="text-sm tabular-nums" data-linha-subtotal></p>
    </div>
    <div class="flex items-center rounded-lg border-2 border-tinta">
      <button type="button" class="size-11 text-2xl leading-none" data-linha-menos>−</button>
      <span class="min-w-6 text-center font-bold tabular-nums" data-linha-qtd></span>
      <button type="button" class="size-11 text-2xl leading-none" data-linha-mais>+</button>
    </div>
  </li>
</template>
